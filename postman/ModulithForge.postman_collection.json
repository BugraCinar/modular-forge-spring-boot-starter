{
  "info": {
    "name": "ModulithForge API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "xsrfToken", "value": "" }
  ],
  "item": [
    {
      "name": "Discover modules",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/modules"
      }
    },
    {
      "name": "Register user",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"local_user\",\n  \"email\": \"user@example.com\",\n  \"password\": \"ChangeMe123!\",\n  \"firstName\": \"Local\",\n  \"lastName\": \"User\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"local_user\",\n  \"password\": \"ChangeMe123!\",\n  \"role\": \"user\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      },
      "event": [{
        "listen": "test",
        "script": { "exec": ["const body = pm.response.json();", "if (body.accessToken) pm.collectionVariables.set('accessToken', body.accessToken);"] }
      }]
    },
    {
      "name": "Current account",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/v1/auth/me"
      }
    },
    {
      "name": "Get browser CSRF token",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/auth/csrf"
      },
      "event": [{
        "listen": "test",
        "script": { "exec": ["const body = pm.response.json();", "pm.collectionVariables.set('xsrfToken', body.token);"] }
      }]
    },
    {
      "name": "Refresh browser session",
      "request": {
        "method": "POST",
        "header": [{ "key": "X-XSRF-TOKEN", "value": "{{xsrfToken}}" }],
        "url": "{{baseUrl}}/api/v1/auth/refresh"
      }
    }
  ]
}
