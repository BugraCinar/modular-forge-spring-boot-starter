APP_NAME=ModularForge
APP_VERSION=1.0.0
SERVER_PORT=8080
API_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
SPRING_PROFILES_ACTIVE=mysql,dev

# Generate three independent values with: openssl rand -base64 32
PEPPER=
TOKEN_HASH_SECRET=
JWT_SECRET=
JWT_ISSUER=modular-forge
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=modularforge
DB_USER=modularforge
DB_PASSWORD=
DB_SSL_MODE=DISABLED

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
RATE_LIMIT_FAIL_OPEN=true

CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-XSRF-TOKEN
COOKIE_SECURE=false

MODULE_ADMIN_MANAGEMENT_ENABLED=true
MODULE_USER_PROFILE_ENABLED=true
MODULE_AUDIT_ENABLED=true
MODULE_EMAIL_ENABLED=true
MODULE_TWO_FACTOR_ENABLED=false
MODULE_IMAGE_STORAGE_ENABLED=false
MODULE_DATABASE_BACKUP_ENABLED=false
MODULE_OBSERVABILITY_ENABLED=false

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=no-reply@example.com
ADMIN_EMAIL=admin@example.com

RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=
RECAPTCHA_EXPECTED_HOSTNAME=localhost
RECAPTCHA_EXPECTED_ACTION=login

# Required only when the TOTP module is enabled; exactly 32 random bytes in Base64.
TWO_FACTOR_ENCRYPTION_KEY=

# Required only when the R2 image-storage adapter is enabled.
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_DOMAIN=

DATABASE_BACKUP_EMAIL=
DATABASE_BACKUP_DIRECTORY=backups
MYSQLDUMP_PATH=mysqldump

APP_SWAGGER_ENABLED=true
INIT_USERS=false
SEED_ADMIN_USERNAME=local_admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_USER_USERNAME=local_user
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=

SENTRY_DSN=
SENTRY_LOGS_ENABLED=true
SENTRY_TRACES_SAMPLE_RATE=0.05
